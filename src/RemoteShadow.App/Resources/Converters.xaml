<!--
  Конвертеры значений для привязок. Подключены в App.xaml, поэтому доступны на любой странице:
  Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"
  Параметры: "invert" (наоборот), "hidden" (Hidden вместо Collapsed).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:RemoteShadow.App.Shell.Converters">

  <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
  <conv:InverseBoolConverter x:Key="InverseBoolConverter" />
  <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
  <conv:EmptyToVisibilityConverter x:Key="EmptyToVisibilityConverter" />
  <conv:IconGlyphConverter x:Key="IconGlyphConverter" />
  <conv:RelativeTimeConverter x:Key="RelativeTimeConverter" />
  <conv:StatusToBrushConverter x:Key="StatusToBrushConverter" />
  <conv:StatusToBadgeStyleConverter x:Key="StatusToBadgeStyleConverter" />
  <conv:OnlineStatusConverter x:Key="OnlineStatusConverter" />
  <conv:SessionStateTextConverter x:Key="SessionStateTextConverter" />
  <conv:AvailabilityStatusConverter x:Key="AvailabilityStatusConverter" />
  <conv:ProtocolAvailabilityTextConverter x:Key="ProtocolAvailabilityTextConverter" />
  <conv:FavoriteButtonTextConverter x:Key="FavoriteButtonTextConverter" />
  <conv:AnyTrueToVisibilityConverter x:Key="AnyTrueToVisibilityConverter" />
  <conv:BoolToTextConverter x:Key="BoolToTextConverter" />
  <conv:NotNullToBoolConverter x:Key="NotNullToBoolConverter" />
  <conv:EmptyLoadedToVisibilityConverter x:Key="EmptyLoadedToVisibilityConverter" />

</ResourceDictionary>
