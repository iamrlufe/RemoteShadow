<local:DialogWindowBase x:Class="RemoteShadow.App.Shell.Dialogs.PasswordResetDialog"
                        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:local="clr-namespace:RemoteShadow.App.Shell.Dialogs"
                        Width="520"
                        MaxHeight="720">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Focusable="False">
      <StackPanel Margin="24,24,24,16">
        <TextBlock Text="Сброс пароля" Style="{StaticResource DialogTitleStyle}" />
        <TextBlock x:Name="UserText" Margin="0,8,0,0" TextWrapping="Wrap" />

        <!-- Режим -->
        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
          <RadioButton x:Name="GenerateRadio"
                       GroupName="PasswordMode"
                       Content="Сгенерировать"
                       IsChecked="True"
                       Margin="0,0,24,0"
                       Checked="OnModeChanged" />
          <RadioButton x:Name="ManualRadio"
                       GroupName="PasswordMode"
                       Content="Ввести вручную"
                       Checked="OnModeChanged" />
        </StackPanel>

        <!-- Сгенерировать -->
        <StackPanel x:Name="GeneratePanel" Margin="0,12,0,0">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="GeneratedBox"
                     IsReadOnly="True"
                     FontFamily="Consolas"
                     FontSize="16"
                     VerticalContentAlignment="Center"
                     AutomationProperties.Name="Сгенерированный пароль" />
            <Button x:Name="RevealButton"
                    Grid.Column="1"
                    Margin="8,0,0,0"
                    Style="{StaticResource IconButtonStyle}"
                    Content="&#xE7B3;"
                    ToolTip="Показать пароль"
                    AutomationProperties.Name="Показать пароль"
                    Click="OnRevealClick" />
            <Button x:Name="CopyButton"
                    Grid.Column="2"
                    Style="{StaticResource IconButtonStyle}"
                    Content="&#xE8C8;"
                    ToolTip="Копировать (буфер обмена очистится через 60 секунд)"
                    AutomationProperties.Name="Копировать пароль"
                    Click="OnCopyClick" />
            <Button x:Name="RegenerateButton"
                    Grid.Column="3"
                    Style="{StaticResource IconButtonStyle}"
                    Content="&#xE72C;"
                    ToolTip="Сгенерировать другой пароль"
                    AutomationProperties.Name="Сгенерировать другой пароль"
                    Click="OnRegenerateClick" />
          </Grid>
          <TextBlock x:Name="GenerateHint"
                     Margin="0,8,0,0"
                     Style="{StaticResource CaptionMutedTextStyle}"
                     Text="Пароль не сохраняется. Нажмите «Показать» или «Копировать», чтобы передать его пользователю. Буфер обмена очистится через 60 секунд." />
        </StackPanel>

        <!-- Ввести вручную -->
        <StackPanel x:Name="ManualPanel" Margin="0,12,0,0" Visibility="Collapsed">
          <TextBlock Text="Новый пароль" Margin="0,0,0,4" />
          <PasswordBox x:Name="NewPasswordBox"
                       AutomationProperties.Name="Новый пароль"
                       PasswordChanged="OnPasswordChanged" />
          <TextBlock Text="Подтверждение пароля" Margin="0,12,0,4" />
          <PasswordBox x:Name="ConfirmPasswordBox"
                       AutomationProperties.Name="Подтверждение пароля"
                       PasswordChanged="OnPasswordChanged" />
          <TextBlock x:Name="MismatchText"
                     Margin="0,6,0,0"
                     Text="Пароли не совпадают."
                     Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                     Visibility="Collapsed" />
        </StackPanel>

        <CheckBox x:Name="MustChangeBox"
                  Margin="0,18,0,0"
                  IsChecked="True"
                  Content="Потребовать смену пароля при следующем входе" />
      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="1"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Margin="24,0,24,20">
      <Button x:Name="ResetButton"
              Content="Сбросить пароль"
              Style="{StaticResource PrimaryButtonStyle}"
              IsDefault="True"
              Click="OnResetClick" />
      <Button Content="Отмена"
              Margin="8,0,0,0"
              MinWidth="96"
              IsCancel="True" />
    </StackPanel>
  </Grid>
</local:DialogWindowBase>
