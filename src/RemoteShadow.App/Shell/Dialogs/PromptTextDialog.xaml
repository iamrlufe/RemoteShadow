<local:DialogWindowBase x:Class="RemoteShadow.App.Shell.Dialogs.PromptTextDialog"
                        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:local="clr-namespace:RemoteShadow.App.Shell.Dialogs"
                        Width="480"
                        MaxHeight="640">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="24,24,24,16">
      <TextBlock x:Name="HeadingText" Style="{StaticResource DialogTitleStyle}" />
      <TextBlock x:Name="MessageText" Margin="0,8,0,0" TextWrapping="Wrap" />
      <TextBox x:Name="InputBox"
               Margin="0,16,0,0"
               TextChanged="OnInputChanged" />
      <TextBlock x:Name="MultilineHint"
                 Margin="0,4,0,0"
                 Style="{StaticResource CaptionMutedTextStyle}"
                 Text="Ctrl+Enter — подтвердить."
                 Visibility="Collapsed" />
    </StackPanel>

    <StackPanel Grid.Row="1"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Margin="24,0,24,20">
      <Button x:Name="OkButton"
              Content="ОК"
              Style="{StaticResource PrimaryButtonStyle}"
              IsDefault="True"
              Click="OnOkClick" />
      <Button Content="Отмена"
              Margin="8,0,0,0"
              MinWidth="96"
              IsCancel="True" />
    </StackPanel>
  </Grid>
</local:DialogWindowBase>
