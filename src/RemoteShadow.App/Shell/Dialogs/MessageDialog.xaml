<local:DialogWindowBase x:Class="RemoteShadow.App.Shell.Dialogs.MessageDialog"
                        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:local="clr-namespace:RemoteShadow.App.Shell.Dialogs"
                        Width="480"
                        MaxHeight="640">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="24,24,24,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <TextBlock x:Name="IconText"
                 Style="{StaticResource IconTextStyle}"
                 FontSize="28"
                 VerticalAlignment="Top"
                 Margin="0,0,16,0" />
      <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" MaxHeight="440" Focusable="False">
        <StackPanel>
          <TextBlock x:Name="HeadingText" Style="{StaticResource DialogTitleStyle}" />
          <TextBlock x:Name="MessageText" Margin="0,8,0,0" TextWrapping="Wrap" />
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <StackPanel Grid.Row="1"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Margin="24,0,24,20">
      <Button x:Name="CopyButton"
              Content="Копировать текст"
              Margin="0,0,8,0"
              Visibility="Collapsed"
              Click="OnCopyClick" />
      <Button x:Name="OkButton"
              Content="OK"
              Style="{StaticResource PrimaryButtonStyle}"
              IsDefault="True"
              IsCancel="True"
              Click="OnOkClick" />
    </StackPanel>
  </Grid>
</local:DialogWindowBase>
