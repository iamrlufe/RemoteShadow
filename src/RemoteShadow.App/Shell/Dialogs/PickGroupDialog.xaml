<local:DialogWindowBase x:Class="RemoteShadow.App.Shell.Dialogs.PickGroupDialog"
                        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:local="clr-namespace:RemoteShadow.App.Shell.Dialogs"
                        Width="520"
                        Height="540"
                        MinHeight="400"
                        SizeToContent="Manual"
                        ResizeMode="CanResize">
  <Grid Margin="24,24,24,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock x:Name="HeadingText" Style="{StaticResource DialogTitleStyle}" />

    <!-- Поиск -->
    <Grid Grid.Row="1" Margin="0,16,0,0">
      <TextBox x:Name="SearchBox"
               Padding="32,0,8,0"
               VerticalContentAlignment="Center"
               MinHeight="34"
               AutomationProperties.Name="Поиск группы"
               TextChanged="OnSearchTextChanged"
               PreviewKeyDown="OnSearchKeyDown" />
      <TextBlock Text="&#xE721;"
                 Style="{StaticResource IconTextStyle}"
                 FontSize="14"
                 HorizontalAlignment="Left"
                 Margin="11,0,0,0"
                 IsHitTestVisible="False"
                 Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
      <TextBlock Text="Часть названия группы"
                 Margin="34,0,0,0"
                 VerticalAlignment="Center"
                 IsHitTestVisible="False"
                 Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                 Visibility="{Binding Text, ElementName=SearchBox, Converter={StaticResource EmptyToVisibilityConverter}}" />
    </Grid>

    <!-- Индикатор загрузки -->
    <ProgressBar x:Name="LoadingBar"
                 Grid.Row="2"
                 Height="3"
                 Margin="0,4,0,0"
                 IsIndeterminate="True"
                 Visibility="Hidden"
                 AutomationProperties.Name="Идёт поиск" />

    <!-- Результаты -->
    <Grid Grid.Row="3" Margin="0,8,0,0">
      <ListBox x:Name="ResultsList"
               ItemContainerStyle="{StaticResource ListItemStyle}"
               BorderThickness="1"
               BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
               Background="Transparent"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               AutomationProperties.Name="Найденные группы"
               SelectionChanged="OnSelectionChanged"
               MouseDoubleClick="OnResultDoubleClick">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel>
              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding Description}"
                         Style="{StaticResource CaptionMutedTextStyle}"
                         TextWrapping="NoWrap"
                         TextTrimming="CharacterEllipsis"
                         Visibility="{Binding Description, Converter={StaticResource NullToVisibilityConverter}}" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <TextBlock x:Name="StatusText"
                 Style="{StaticResource MutedTextStyle}"
                 TextAlignment="Center"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Margin="24"
                 IsHitTestVisible="False"
                 AutomationProperties.LiveSetting="Polite" />
    </Grid>

    <StackPanel Grid.Row="4"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Margin="0,16,0,0">
      <Button x:Name="SelectButton"
              Content="Выбрать"
              Style="{StaticResource PrimaryButtonStyle}"
              IsDefault="True"
              IsEnabled="False"
              Click="OnSelectClick" />
      <Button Content="Отмена"
              Margin="8,0,0,0"
              MinWidth="96"
              IsCancel="True" />
    </StackPanel>
  </Grid>
</local:DialogWindowBase>
