<UserControl x:Class="RemoteShadow.App.Shell.Actions.ActionBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:RemoteShadow.App.Shell.Actions"
             x:Name="Root"
             IsTabStop="False"
             Focusable="False">
  <UserControl.Resources>
    <DataTemplate x:Key="ActionButtonTemplate" DataType="{x:Type local:ActionButtonModel}">
      <Button Style="{StaticResource FlatActionButtonStyle}"
              Command="{Binding Command}"
              IsEnabled="{Binding IsEnabled}"
              ToolTip="{Binding ToolTipText}"
              ToolTipService.ShowOnDisabled="True"
              AutomationProperties.Name="{Binding Title}">
        <StackPanel Orientation="Horizontal">
          <TextBlock Style="{StaticResource IconTextStyle}"
                     FontSize="14"
                     Margin="0,0,8,0"
                     Text="{Binding Icon, Converter={StaticResource IconGlyphConverter}}"
                     Visibility="{Binding HasIcon, Converter={StaticResource BoolToVisibilityConverter}}" />
          <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
    </DataTemplate>
  </UserControl.Resources>

  <StackPanel>
    <!-- Индикатор выполнения -->
    <StackPanel Margin="0,0,0,8"
                Visibility="{Binding IsBusy, ElementName=Root, Converter={StaticResource BoolToVisibilityConverter}}">
      <ProgressBar IsIndeterminate="True"
                   Height="3"
                   AutomationProperties.Name="Выполняется действие" />
      <TextBlock Margin="0,4,0,0"
                 Style="{StaticResource CaptionMutedTextStyle}"
                 Text="{Binding BusyText, ElementName=Root}"
                 Visibility="{Binding BusyText, ElementName=Root, Converter={StaticResource NullToVisibilityConverter}}" />
    </StackPanel>

    <TextBlock x:Name="EmptyText"
               Style="{StaticResource MutedTextStyle}"
               Text="Нет доступных действий"
               Visibility="Collapsed" />

    <!-- Кнопки по группам -->
    <ItemsControl x:Name="GroupsHost"
                  IsTabStop="False"
                  ItemTemplate="{StaticResource ActionButtonTemplate}">
      <ItemsControl.GroupStyle>
        <GroupStyle>
          <GroupStyle.HeaderTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Name}" Style="{StaticResource GroupHeaderStyle}" />
            </DataTemplate>
          </GroupStyle.HeaderTemplate>
          <GroupStyle.Panel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </GroupStyle.Panel>
          <GroupStyle.ContainerStyle>
            <Style TargetType="GroupItem">
              <Setter Property="Margin" Value="0,0,0,4" />
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="GroupItem">
                    <StackPanel>
                      <ContentPresenter />
                      <ItemsPresenter />
                    </StackPanel>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </GroupStyle.ContainerStyle>
        </GroupStyle>
      </ItemsControl.GroupStyle>
    </ItemsControl>
  </StackPanel>
</UserControl>
