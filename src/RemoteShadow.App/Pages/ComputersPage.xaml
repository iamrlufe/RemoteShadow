<UserControl x:Class="RemoteShadow.App.Pages.ComputersPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:RemoteShadow.Core.Models;assembly=RemoteShadow.Core"
             xmlns:actions="clr-namespace:RemoteShadow.App.Shell.Actions"
             xmlns:pages="clr-namespace:RemoteShadow.App.Pages">
  <UserControl.Resources>
    <pages:EnumTextConverter x:Key="EnumTextConverter" />
    <DataTemplate x:Key="EnumItemTemplate">
      <TextBlock Text="{Binding Converter={StaticResource EnumTextConverter}}" />
    </DataTemplate>
  </UserControl.Resources>
  <Grid>
    <Grid.ColumnDefinitions>
      <!-- Список занимает 2/5 ширины (300–440): на узком окне карточке компьютера остаётся место. -->
      <ColumnDefinition Width="2*" MinWidth="300" MaxWidth="440" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="3*" />
    </Grid.ColumnDefinitions>

    <!-- ===== Список компьютеров: дерево категорий, фильтры, поиск, таблица ===== -->
    <DockPanel x:Name="LeftPanel" Grid.Column="0" Margin="16,16,8,16">
      <TextBlock DockPanel.Dock="Top" Text="Компьютеры" Style="{StaticResource PageTitleStyle}" Margin="0,0,0,10" />

      <!-- Главные действия всегда на виду: обновить список из AD, перепроверить доступность, избранное -->
      <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="8" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Button Content="Обновить список" Command="{Binding RefreshListCommand}" HorizontalAlignment="Stretch" Padding="6,6"
                ToolTip="Заново загрузить все компьютеры из AD (новые, переименованные, включённые или отключённые в каталоге). Доступность не проверяет. Ctrl+F5"
                AutomationProperties.Name="Обновить список" />
        <Button Grid.Column="2" Content="Обновить статусы" Command="{Binding RefreshVisibleAvailabilityCommand}" HorizontalAlignment="Stretch" Padding="6,6"
                ToolTip="Повторно проверить DNS, ping, RDP, SMB и SSH для компьютеров текущей области (поиск, группа, подразделение). Фильтры по доступности, протоколам и IP при выборе области не учитываются, поэтому ранее выключенный компьютер будет проверен снова. F5"
                AutomationProperties.Name="Обновить статусы" />
      </Grid>

      <!-- Идёт загрузка списка из AD или проверка статусов -->
      <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
        <Grid.Visibility>
          <MultiBinding Converter="{StaticResource AnyTrueToVisibilityConverter}">
            <Binding Path="IsRefreshingList" />
            <Binding Path="IsCheckingAvailability" />
          </MultiBinding>
        </Grid.Visibility>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <ProgressBar IsIndeterminate="True" Height="3" AutomationProperties.Name="Идёт обновление" />
          <TextBlock Margin="0,4,0,0" Style="{StaticResource CaptionMutedTextStyle}"
                     Text="{Binding IsRefreshingList, Converter={StaticResource BoolToTextConverter}, ConverterParameter='Загрузка списка из AD…|Проверка статусов…'}" />
        </StackPanel>
        <Button Grid.Column="1" Content="Отменить" Margin="8,0,0,0"
                Command="{Binding CancelAvailabilityRefreshCommand}"
                Visibility="{Binding IsCheckingAvailability, Converter={StaticResource BoolToVisibilityConverter}}"
                AutomationProperties.Name="Отменить проверку статусов" />
      </Grid>

      <!-- Поиск и «только избранные» в одной строке: экономит высоту, список компьютеров не вытесняется -->
      <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid>
          <TextBox x:Name="FilterBox"
                   MinHeight="34"
                   Padding="8,6"
                   Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                   PreviewKeyDown="OnFilterBoxKeyDown"
                   ToolTip="Имя, описание или ОС"
                   AutomationProperties.Name="Поиск компьютера"
                   AutomationProperties.AcceleratorKey="Ctrl+F" />
          <TextBlock Text="Поиск (Ctrl+F)"
                     Margin="11,0,8,0"
                     VerticalAlignment="Center"
                     IsHitTestVisible="False"
                     TextTrimming="CharacterEllipsis"
                     Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                     Visibility="{Binding SearchText, Converter={StaticResource EmptyToVisibilityConverter}}" />
        </Grid>
        <CheckBox Grid.Column="1" Content="★ Избранные" IsChecked="{Binding OnlyFavorites}" VerticalAlignment="Center" Margin="8,0,0,0" Padding="6,0,0,0"
                  ToolTip="Показывать только избранные компьютеры" AutomationProperties.Name="Только избранные" />
      </Grid>

      <!-- Вкладки колонки: список компьютеров или одна из панелей на всю высоту -->
      <UniformGrid DockPanel.Dock="Top" Rows="1" Margin="0,0,0,8">
        <RadioButton x:Name="TabList" Style="{StaticResource TabChipStyle}" Content="Список" Tag="list" GroupName="ComputersTab"
                     Checked="OnTabChecked" AutomationProperties.Name="Список компьютеров" />
        <RadioButton Style="{StaticResource TabChipStyle}" Content="Группы" Tag="groups" GroupName="ComputersTab"
                     Checked="OnTabChecked" AutomationProperties.Name="Группы" />
        <RadioButton Style="{StaticResource TabChipStyle}" Content="Подсети" Tag="subnets" GroupName="ComputersTab"
                     Checked="OnTabChecked" AutomationProperties.Name="Подсети и сканирование" />
        <RadioButton Style="{StaticResource TabChipStyle}" Content="Фильтры" Tag="filters" GroupName="ComputersTab"
                     Checked="OnTabChecked" AutomationProperties.Name="Фильтры и сортировка" />
        <RadioButton x:Name="TabFound" Style="{StaticResource TabChipStyle}" Content="Найдено" Tag="found" GroupName="ComputersTab"
                     Checked="OnTabChecked" AutomationProperties.Name="Найдено сканированием"
                     ToolTip="Устройства, найденные при сканировании подсетей" />
      </UniformGrid>

      <!-- Сканирование подсети: ход и отмена всегда на виду, а не внутри прокручиваемой панели подсетей -->
      <Grid DockPanel.Dock="Top" Margin="0,0,0,8"
            Visibility="{Binding ScanStatus, Converter={StaticResource NullToVisibilityConverter}}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <ProgressBar IsIndeterminate="True" Height="3" Margin="0,0,0,4"
                       Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibilityConverter}}"
                       AutomationProperties.Name="Идёт сканирование подсети" />
          <TextBlock Text="{Binding ScanStatus}" Style="{StaticResource CaptionMutedTextStyle}" TextWrapping="Wrap" />
        </StackPanel>
        <Button Grid.Column="1" Content="Отменить" Margin="8,0,0,0" Command="{Binding CancelScanCommand}"
                Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibilityConverter}}"
                AutomationProperties.Name="Отменить сканирование" />
      </Grid>

      <!-- «Найти пользователя на компьютерах» (из поиска Ctrl+K): где сейчас работает пользователь -->
      <Border DockPanel.Dock="Top" Style="{StaticResource CardStyle}" Padding="12,10" Margin="0,0,0,8"
              Visibility="{Binding HasFindPanel, Converter={StaticResource BoolToVisibilityConverter}}">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"
                       ToolTip="{Binding FindQuery}"><Run Text="Где работает «" /><Run Text="{Binding FindQuery, Mode=OneWay}" /><Run Text="»" /></TextBlock>
            <Button Grid.Column="1" Content="Остановить" Margin="8,0,0,0" Command="{Binding CancelFindCommand}"
                    Visibility="{Binding IsFinding, Converter={StaticResource BoolToVisibilityConverter}}"
                    AutomationProperties.Name="Остановить поиск пользователя" />
            <Button Grid.Column="2" Content="&#xE711;" Style="{StaticResource IconButtonStyle}" Width="28" Height="28" FontSize="12"
                    Margin="4,0,0,0" Command="{Binding CloseFindCommand}"
                    ToolTip="Закрыть результаты поиска" AutomationProperties.Name="Закрыть результаты поиска пользователя" />
          </Grid>
          <ProgressBar IsIndeterminate="True" Height="3" Margin="0,6,0,0"
                       Visibility="{Binding IsFinding, Converter={StaticResource BoolToVisibilityConverter}}"
                       AutomationProperties.Name="Идёт поиск пользователя" />
          <TextBlock Text="{Binding FindStatus}" Style="{StaticResource CaptionMutedTextStyle}" Margin="0,4,0,0" />
          <ListBox ItemsSource="{Binding FoundLocations}" SelectedItem="{Binding SelectedLocation, Mode=TwoWay}"
                   BorderThickness="0" Background="Transparent" MaxHeight="150" Margin="0,4,0,0"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   ItemContainerStyle="{StaticResource ListItemStyle}"
                   Visibility="{Binding FoundLocations.Count, Converter={StaticResource EmptyToVisibilityConverter}, ConverterParameter=invert}"
                   AutomationProperties.Name="Найденные сессии пользователя">
            <ListBox.ItemTemplate>
              <DataTemplate DataType="{x:Type models:UserLocation}">
                <StackPanel>
                  <TextBlock TextTrimming="CharacterEllipsis"><Run Text="{Binding Computer.Name, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" · " /><Run Text="{Binding Session.AccountName, Mode=OneWay}" /></TextBlock>
                  <TextBlock Style="{StaticResource CaptionMutedTextStyle}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"><Run Text="{Binding Session.State, Mode=OneWay, Converter={StaticResource SessionStateTextConverter}}" /><Run Text=" · сессия " /><Run Text="{Binding Session.Id, Mode=OneWay}" /><Run Text="{Binding FromCache, Mode=OneWay, Converter={StaticResource BoolToTextConverter}, ConverterParameter=' · из кэша|'}" /></TextBlock>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>
      </Border>

      <!-- Активная группа сужает список, а список групп спрятан в свёрнутой панели: сброс всегда на виду -->
      <Grid DockPanel.Dock="Top" Margin="0,0,0,8"
            Visibility="{Binding HasSelectedGroup, Converter={StaticResource BoolToVisibilityConverter}}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" ToolTip="{Binding SelectedGroup.Name}">
          <Run Text="Группа: " /><Run Text="{Binding SelectedGroup.Name, Mode=OneWay}" FontWeight="SemiBold" />
        </TextBlock>
        <Button Grid.Column="1" Content="Показать все" Command="{Binding ClearGroupFilterCommand}" ToolTip="Снять фильтр по группе и показать все компьютеры"
                AutomationProperties.Name="Показать все компьютеры" />
      </Grid>

      <!-- Фильтры: свёрнуты по умолчанию, раскрытая панель прокручивается и не вытесняет список.
           320 показывает все фильтры (включая чекбоксы RDP/SMB/SSH и «Показывать отключённые») и сортировку
           без внутренней прокрутки на обычном окне — раньше 150px обрезали их ниже видимой области. -->
      <StackPanel x:Name="ListSummaryPanel" DockPanel.Dock="Top">
        <TextBlock Text="{Binding ListSummary}" Style="{StaticResource CaptionMutedTextStyle}" Margin="0,0,0,4" />
        <TextBlock Text="{Binding ActiveFiltersSummary}" TextWrapping="Wrap" Style="{StaticResource CaptionMutedTextStyle}" Margin="0,0,0,4"
                   Visibility="{Binding ActiveFiltersSummary, Converter={StaticResource NullToVisibilityConverter}}" />

        <TextBlock Text="{Binding AutoCheckHint}" TextWrapping="Wrap" Style="{StaticResource CaptionMutedTextStyle}" Margin="0,0,0,4"
                   Visibility="{Binding AutoCheckHint, Converter={StaticResource NullToVisibilityConverter}}" />

        <TextBlock Text="{Binding EmptyListHint}" TextWrapping="Wrap" Style="{StaticResource CaptionMutedTextStyle}" Margin="0,0,0,4"
                   Visibility="{Binding EmptyListHint, Converter={StaticResource NullToVisibilityConverter}}" />
      </StackPanel>

      <!-- Содержимое колонки: одна из вкладок целиком, без вытеснения списка и без прокрутки в прокрутке -->
      <Grid>
        <ListBox x:Name="ComputerList"
                 ItemsSource="{Binding Computers}" MinHeight="90"
                 SelectedItem="{Binding SelectedComputer, Mode=TwoWay}"
                 PreviewKeyDown="OnComputerListKeyDown"
                 MouseDoubleClick="OnComputerListDoubleClick"
                 BorderThickness="0"
                 Background="Transparent"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingStackPanel.IsVirtualizing="True"
                 VirtualizingStackPanel.VirtualizationMode="Recycling"
                 AutomationProperties.Name="Список компьютеров">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem" BasedOn="{StaticResource ListItemStyle}">
              <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate DataType="{x:Type models:ComputerInfo}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Ellipse Style="{StaticResource StatusDotStyle}"
                         Margin="0,0,10,0"
                         Tag="{Binding AvailabilityStatus, Converter={StaticResource AvailabilityStatusConverter}}" />
                <StackPanel Grid.Column="1">
                  <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Style="{StaticResource CaptionMutedTextStyle}"
                             TextWrapping="NoWrap"
                             TextTrimming="CharacterEllipsis"><Run Text="{Binding IpAddresses[0], Mode=OneWay, FallbackValue='IP неизвестен', TargetNullValue='IP неизвестен'}" /><Run Text=" · Ping " /><Run Text="{Binding IcmpAvailable, Mode=OneWay, Converter={StaticResource ProtocolAvailabilityTextConverter}}" /><Run Text=" · RDP " /><Run Text="{Binding RdpAvailable, Mode=OneWay, Converter={StaticResource ProtocolAvailabilityTextConverter}}" /><Run Text=" · SMB " /><Run Text="{Binding SmbAvailable, Mode=OneWay, Converter={StaticResource ProtocolAvailabilityTextConverter}}" /><Run Text=" · SSH " /><Run Text="{Binding SshAvailable, Mode=OneWay, Converter={StaticResource ProtocolAvailabilityTextConverter}}" /></TextBlock>
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <ScrollViewer x:Name="GroupsScroll" VerticalAlignment="Stretch" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
          <StackPanel Margin="0,8,8,0">
            <TextBlock Text="Мои группы" Style="{StaticResource CaptionMutedTextStyle}" Margin="0,4,0,2" />
            <ListBox ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup, Mode=TwoWay}"
                     BorderThickness="0" Background="Transparent"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     PreviewMouseWheel="OnNestedListWheel"
                     KeyDown="OnGroupsKeyDown"
                     AutomationProperties.Name="Пользовательские группы компьютеров">
              <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem" BasedOn="{StaticResource ListItemStyle}">
                  <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                </Style>
              </ListBox.ItemContainerStyle>
              <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type models:ComputerGroup}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                    <Button Grid.Column="1" Content="&#xE70F;" ToolTip="Переименовать группу" AutomationProperties.Name="Переименовать группу"
                            Command="{Binding DataContext.RenameGroupCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                            CommandParameter="{Binding}" Style="{StaticResource IconButtonStyle}" Width="24" Height="24" />
                    <Button Grid.Column="2" Content="&#xE711;" ToolTip="Удалить группу (Delete). Компьютеры в AD не удаляются." AutomationProperties.Name="Удалить группу"
                            Command="{Binding DataContext.DeleteGroupCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                            CommandParameter="{Binding}" Style="{StaticResource IconButtonStyle}" Width="24" Height="24" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <Grid Margin="0,4,0,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBox Text="{Binding NewGroupName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Название новой группы">
                <TextBox.InputBindings>
                  <KeyBinding Key="Enter" Command="{Binding CreateGroupCommand}" />
                </TextBox.InputBindings>
              </TextBox>
              <TextBlock Text="Новая группа" Margin="11,0,8,0" VerticalAlignment="Center" IsHitTestVisible="False"
                         Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                         Visibility="{Binding NewGroupName, Converter={StaticResource EmptyToVisibilityConverter}}" />
              <Button Grid.Column="1" Content="Добавить" Margin="4,0,0,0" Command="{Binding CreateGroupCommand}" AutomationProperties.Name="Добавить группу" />
            </Grid>
            <StackPanel Margin="0,0,0,8" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibilityConverter}}">
              <TextBlock Text="Выбранный компьютер и группа" Style="{StaticResource CaptionMutedTextStyle}" />
              <ComboBox ItemsSource="{Binding Groups}" SelectedItem="{Binding MembershipGroup}" DisplayMemberPath="Name"
                        Margin="0,2,0,4" AutomationProperties.Name="Группа для добавления компьютера">
                <ComboBox.ItemContainerStyle>
                  <Style TargetType="ComboBoxItem">
                    <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                  </Style>
                </ComboBox.ItemContainerStyle>
              </ComboBox>
              <StackPanel Orientation="Horizontal">
                <Button Content="+ в группу" Command="{Binding AddSelectedComputerToGroupCommand}" CommandParameter="{Binding MembershipGroup}" Margin="0,0,4,0"
                        ToolTip="Добавить выбранный компьютер в группу" AutomationProperties.Name="Добавить компьютер в группу" />
                <Button Content="− из группы" Command="{Binding RemoveComputerFromGroupCommand}" CommandParameter="{Binding MembershipGroup}"
                        ToolTip="Убрать выбранный компьютер из группы" AutomationProperties.Name="Убрать компьютер из группы" />
              </StackPanel>
            </StackPanel>
          </StackPanel>
          </ScrollViewer>

        <ScrollViewer x:Name="SubnetsScroll" VerticalAlignment="Stretch" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
          <StackPanel Margin="0,8,8,0">
                      <ListBox ItemsSource="{Binding Subnets}" SelectedItem="{Binding SelectedSubnet, Mode=TwoWay}"
                     BorderThickness="0" Background="Transparent"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     PreviewMouseWheel="OnNestedListWheel"
                     AutomationProperties.Name="Подсети для сканирования">
              <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem" BasedOn="{StaticResource ListItemStyle}">
                  <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                </Style>
              </ListBox.ItemContainerStyle>
              <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type models:SubnetDefinition}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="{Binding Name}" />
                      <TextBlock Text="{Binding Cidr}" Style="{StaticResource CaptionMutedTextStyle}" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Сканировать"
                            Command="{Binding DataContext.ScanSubnetCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                            CommandParameter="{Binding}" Margin="4,0" />
                    <Button Grid.Column="2" Content="&#xE711;" ToolTip="Удалить подсеть" AutomationProperties.Name="Удалить подсеть"
                            Command="{Binding DataContext.DeleteSubnetCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                            CommandParameter="{Binding}" Style="{StaticResource IconButtonStyle}" Width="24" Height="24" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Margin="0,4,0,4">
              <Grid Margin="0,0,0,4">
                <TextBox Text="{Binding NewSubnetName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Название подсети" />
                <TextBlock Text="Название подсети" Margin="11,0,8,0" VerticalAlignment="Center" IsHitTestVisible="False"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           Visibility="{Binding NewSubnetName, Converter={StaticResource EmptyToVisibilityConverter}}" />
              </Grid>
              <Grid Margin="0,0,0,4">
                <TextBox Text="{Binding NewSubnetCidr, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="CIDR подсети, например 10.0.0.0/24" />
                <TextBlock Text="CIDR, например 10.0.0.0/24" Margin="11,0,8,0" VerticalAlignment="Center" IsHitTestVisible="False"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           Visibility="{Binding NewSubnetCidr, Converter={StaticResource EmptyToVisibilityConverter}}" />
              </Grid>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox ItemTemplate="{StaticResource EnumItemTemplate}" ItemsSource="{Binding ProbeKindValues}" SelectedItem="{Binding NewSubnetProbeKind}"
                          ToolTip="Чем проверять адреса при сканировании" AutomationProperties.Name="Способ проверки адресов" />
                <Button Grid.Column="1" Content="Добавить подсеть" Margin="4,0,0,0" Command="{Binding AddSubnetCommand}" />
              </Grid>
            </StackPanel>
          </StackPanel>
          </ScrollViewer>

        <ScrollViewer x:Name="FiltersScroll" VerticalAlignment="Stretch" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
            <StackPanel Margin="0,8,8,0">
              <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="8" />
                  <ColumnDefinition Width="1.25*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="Доступность" Style="{StaticResource CaptionMutedTextStyle}" />
                  <ComboBox ItemTemplate="{StaticResource EnumItemTemplate}" ItemsSource="{Binding AvailabilityFilterValues}" SelectedItem="{Binding AvailabilityFilter}" AutomationProperties.Name="Фильтр по доступности" Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="Источник" Style="{StaticResource CaptionMutedTextStyle}" />
                  <ComboBox ItemTemplate="{StaticResource EnumItemTemplate}" ItemsSource="{Binding SourceFilterValues}" SelectedItem="{Binding SourceFilter}" AutomationProperties.Name="Фильтр по источнику" Margin="0,2,0,0" />
                </StackPanel>
              </Grid>
  
              <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="8" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid>
                  <TextBox Padding="8,6" Text="{Binding IpFilter, UpdateSourceTrigger=PropertyChanged}"
                           ToolTip="Известен после «Обновить статусы» или сканирования подсети"
                           AutomationProperties.Name="Фильтр по IP-адресу" />
                  <TextBlock Text="IP-адрес" Margin="11,0,8,0" VerticalAlignment="Center" IsHitTestVisible="False"
                             Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                             Visibility="{Binding IpFilter, Converter={StaticResource EmptyToVisibilityConverter}}" />
                </Grid>
                <Grid Grid.Column="2">
                  <TextBox Padding="8,6" Text="{Binding OuFilter, UpdateSourceTrigger=PropertyChanged}"
                           ToolTip="Часть пути подразделения, например Бухгалтерия"
                           AutomationProperties.Name="Фильтр по подразделению (OU)" />
                  <TextBlock Text="OU" Margin="11,0,8,0" VerticalAlignment="Center" IsHitTestVisible="False"
                             Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                             Visibility="{Binding OuFilter, Converter={StaticResource EmptyToVisibilityConverter}}" />
                </Grid>
              </Grid>
  
              <TextBlock Text="Открытые порты" Style="{StaticResource CaptionMutedTextStyle}" />
              <WrapPanel Margin="0,4,0,0">
                <CheckBox Content="RDP" IsChecked="{Binding FilterRdp}" Margin="0,0,16,4" ToolTip="Только компьютеры с открытым портом RDP (3389)" />
                <CheckBox Content="SMB" IsChecked="{Binding FilterSmb}" Margin="0,0,16,4" ToolTip="Только компьютеры с открытым портом SMB (445)" />
                <CheckBox Content="SSH" IsChecked="{Binding FilterSsh}" Margin="0,0,16,4" ToolTip="Только компьютеры с открытым портом SSH (22)" />
              </WrapPanel>
              <CheckBox Content="Показывать отключённые в AD" IsChecked="{Binding ShowDisabledAd}" Margin="0,2,0,10" />
  
              <TextBlock Text="Сортировка" Style="{StaticResource CaptionMutedTextStyle}" />
              <Grid Margin="0,2,0,10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox ItemTemplate="{StaticResource EnumItemTemplate}" ItemsSource="{Binding SortByValues}" SelectedItem="{Binding SortBy}" AutomationProperties.Name="Сортировка" />
                <CheckBox Grid.Column="1" Content="По убыванию" IsChecked="{Binding SortDescending}" Margin="12,0,0,0" VerticalAlignment="Center"
                          AutomationProperties.Name="Сортировать по убыванию" />
              </Grid>
            </StackPanel>
          </ScrollViewer>

        <ScrollViewer x:Name="DiscoveredScroll" VerticalAlignment="Stretch" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
          <StackPanel>
            <TextBlock Text="Найденных устройств пока нет. Отсканируйте подсеть на вкладке «Подсети»."
                       Style="{StaticResource MutedTextStyle}" Margin="0,8,0,0"
                       Visibility="{Binding DiscoveredDevices.Count, Converter={StaticResource EmptyToVisibilityConverter}}" />
            <TextBlock Text="{Binding EnrichStatus}" Style="{StaticResource CaptionMutedTextStyle}" Margin="0,0,0,4"
                       Visibility="{Binding EnrichStatus, Converter={StaticResource NullToVisibilityConverter}}" />
            <WrapPanel Margin="0,0,0,4">
              <Button Content="Пауза" Command="{Binding PauseEnrichmentCommand}" Margin="0,0,4,4"
                      Visibility="{Binding IsEnriching, Converter={StaticResource BoolToVisibilityConverter}}" />
              <Button Content="Продолжить сбор сведений" Command="{Binding ResumeEnrichmentCommand}" Margin="0,0,4,4"
                      Visibility="{Binding CanResumeEnrichment, Converter={StaticResource BoolToVisibilityConverter}}" />
              <Button Content="Опросить выбранное" Command="{Binding CollectSelectedDeviceCommand}" Margin="0,0,0,4" />
            </WrapPanel>
            <ListBox ItemsSource="{Binding DiscoveredDevices}" SelectedItem="{Binding SelectedDiscovered, Mode=TwoWay}"
                     BorderThickness="0" Background="Transparent"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     PreviewMouseWheel="OnNestedListWheel"
                     ItemContainerStyle="{StaticResource ListItemStyle}" AutomationProperties.Name="Устройства, найденные сканированием">
              <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type models:DiscoveredDevice}">
                  <StackPanel>
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" Margin="0,0,8,0" />
                      <TextBlock Text="не в AD" Style="{StaticResource CaptionMutedTextStyle}"
                                 Visibility="{Binding MatchedComputerId, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=invert}" />
                    </StackPanel>
                    <TextBlock Text="{Binding Summary}" Style="{StaticResource CaptionMutedTextStyle}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="не найден при последнем скане" Style="{StaticResource CaptionMutedTextStyle}"
                               Visibility="{Binding FoundInLastScan, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=invert}" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </StackPanel>
          </ScrollViewer>
      </Grid>

    </DockPanel>

    <Border Grid.Column="1" Style="{StaticResource VerticalDividerStyle}" />

    <!-- ===== Карточка компьютера ===== -->
    <Grid Grid.Column="2">
      <ScrollViewer Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibilityConverter}}"
                    VerticalScrollBarVisibility="Auto">
        <Grid Margin="24">
          <!-- Карточки растягиваются до 760 и прижаты влево: одинаковая ширина при любом наборе кнопок. -->
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MaxWidth="760" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="{Binding SelectedComputer.Name}" Style="{StaticResource PageTitleStyle}" TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding SelectedComputer.Name}" />
            <Button Content="&#xE8C8;" Style="{StaticResource IconButtonStyle}" FontSize="14" Margin="8,2,0,0"
                    Command="{Binding CopyComputerNameCommand}"
                    ToolTip="Копировать имя компьютера (Ctrl+C в списке)" AutomationProperties.Name="Копировать имя компьютера" />
            <!-- Избранное: пустая звезда — добавить, закрашенная — убрать -->
            <Button Command="{Binding ToggleFavoriteCommand}" CommandParameter="{Binding SelectedComputer}" Margin="2,2,0,0">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
                  <Setter Property="Content" Value="&#xE734;" />
                  <Setter Property="FontSize" Value="15" />
                  <Setter Property="ToolTip" Value="Добавить в избранное" />
                  <Setter Property="AutomationProperties.Name" Value="Добавить в избранное" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsSelectedFavorite}" Value="True">
                      <Setter Property="Content" Value="&#xE735;" />
                      <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                      <Setter Property="ToolTip" Value="Убрать из избранного" />
                      <Setter Property="AutomationProperties.Name" Value="Убрать из избранного" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
            </Button>
          </StackPanel>
          <TextBlock Text="{Binding SelectedComputerSubtitle}" Style="{StaticResource MutedTextStyle}" Margin="0,4,0,0" />

          <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
            <StackPanel>
              <TextBlock Text="Подключение и питание" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,8" />
              <actions:ActionBar Actions="{Binding ComputerButtons}"
                                 IsBusy="{Binding ComputerPresenter.IsBusy}"
                                 BusyText="{Binding ComputerPresenter.BusyText}" />
            </StackPanel>
          </Border>

          <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
            <StackPanel>
              <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Сессии" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center" />
                <CheckBox Grid.Column="1"
                          Content="Без запроса пользователю"
                          Margin="12,0,0,0"
                          IsChecked="{Binding NoConsent}"
                          ToolTip="Shadow без согласия пользователя — причина потребуется в диалоге подтверждения и попадёт в журнал." />
              </Grid>

              <TextBlock Text="Идёт загрузка сессий…"
                         Style="{StaticResource MutedTextStyle}"
                         Visibility="{Binding SessionsLoading, Converter={StaticResource BoolToVisibilityConverter}}" />
              <TextBlock Text="{Binding SessionsError}"
                         Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                         Visibility="{Binding SessionsError, Converter={StaticResource NullToVisibilityConverter}}" />
              <TextBlock Text="Сессий нет: на компьютере никто не работает."
                         Style="{StaticResource MutedTextStyle}">
                <TextBlock.Visibility>
                  <MultiBinding Converter="{StaticResource EmptyLoadedToVisibilityConverter}">
                    <Binding Path="Sessions.Count" />
                    <Binding Path="SessionsLoading" />
                    <Binding Path="SessionsError" />
                  </MultiBinding>
                </TextBlock.Visibility>
              </TextBlock>

              <ListBox x:Name="SessionList"
                       ItemsSource="{Binding Sessions}"
                       SelectedItem="{Binding SelectedSession, Mode=TwoWay}"
                       PreviewKeyDown="OnSessionListKeyDown"
                       MouseDoubleClick="OnSessionListDoubleClick"
                       BorderThickness="0"
                       Background="Transparent"
                       MaxHeight="220"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                       ItemContainerStyle="{StaticResource ListItemStyle}"
                       Visibility="{Binding Sessions.Count, Converter={StaticResource EmptyToVisibilityConverter}, ConverterParameter=invert}"
                       AutomationProperties.Name="Список сессий">
                <ListBox.ItemTemplate>
                  <DataTemplate DataType="{x:Type models:SessionInfo}">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock TextTrimming="CharacterEllipsis"><Run Text="{Binding AccountName, Mode=OneWay, TargetNullValue='без пользователя'}" /><Run Text=" · сессия " /><Run Text="{Binding Id, Mode=OneWay}" /></TextBlock>
                        <TextBlock Style="{StaticResource CaptionMutedTextStyle}"
                                   Text="{Binding State, Converter={StaticResource SessionStateTextConverter}}" />
                      </StackPanel>
                      <Border Grid.Column="1"
                              Style="{StaticResource BadgeStyle}"
                              VerticalAlignment="Center"
                              Visibility="{Binding ClientName, Converter={StaticResource NullToVisibilityConverter}}">
                        <TextBlock Text="{Binding ClientName}" />
                      </Border>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>

              <TextBlock Text="Выберите сессию, чтобы увидеть доступные действия. Двойной щелчок или Enter — shadow-просмотр."
                         Style="{StaticResource CaptionMutedTextStyle}"
                         Margin="0,8,0,8"
                         Visibility="{Binding SelectedSession, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=invert}" />
              <actions:ActionBar Actions="{Binding SessionButtons}"
                                 IsBusy="{Binding SessionPresenter.IsBusy}"
                                 BusyText="{Binding SessionPresenter.BusyText}"
                                 Visibility="{Binding SelectedSession, Converter={StaticResource NullToVisibilityConverter}}" />
            </StackPanel>
          </Border>
        </StackPanel>
        </Grid>
      </ScrollViewer>

      <StackPanel Style="{StaticResource EmptyStateStyle}"
                  Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=invert}">
        <TextBlock Text="&#xE977;" Style="{StaticResource IconTextStyle}" FontSize="40"
                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
        <TextBlock Text="Выберите компьютер" Style="{StaticResource EmptyStateTitleStyle}" />
        <TextBlock Text="Слева — все компьютеры домена. Выберите компьютер, чтобы увидеть сессии и доступные действия. Двойной щелчок — подключение по RDP, правая кнопка — все действия."
                   Style="{StaticResource EmptyStateTextStyle}" />
      </StackPanel>

      <!-- Сведения о выбранном найденном устройстве: справа, в большой области, пока открыта панель «Найдено сканированием» -->
      <Grid Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
        <Grid.Style>
          <Style TargetType="Grid">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsVisible, ElementName=DiscoveredScroll}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Grid.Style>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <Border Style="{StaticResource CardStyle}" Margin="24" MinWidth="480" MaxWidth="760" HorizontalAlignment="Left" VerticalAlignment="Top"
                  Visibility="{Binding SelectedDiscoveredText, Converter={StaticResource NullToVisibilityConverter}}">
            <StackPanel>
              <TextBlock Text="Сведения об устройстве" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,8" />
              <TextBox Text="{Binding SelectedDiscoveredText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                       BorderThickness="0" Background="Transparent" Padding="0"
                       AutomationProperties.Name="Сведения об устройстве" />
            </StackPanel>
          </Border>
        </ScrollViewer>
        <StackPanel Style="{StaticResource EmptyStateStyle}"
                    Visibility="{Binding SelectedDiscoveredText, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=invert}">
          <TextBlock Text="&#xE839;" Style="{StaticResource IconTextStyle}" FontSize="40"
                     Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
          <TextBlock Text="Выберите устройство" Style="{StaticResource EmptyStateTitleStyle}" />
          <TextBlock Text="Слева — устройства, найденные при сканировании подсетей. Выберите одно, чтобы увидеть сведения о нём, или нажмите «Опросить выбранное»."
                     Style="{StaticResource EmptyStateTextStyle}" />
        </StackPanel>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
