<UserControl x:Class="RemoteShadow.App.Pages.DiagnosticsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:RemoteShadow.Core.Models;assembly=RemoteShadow.Core"
             xmlns:pages="clr-namespace:RemoteShadow.App.Pages">
  <UserControl.Resources>
    <pages:EnumTextConverter x:Key="EnumTextConverter" />
    <pages:DiagnosticStatusIconConverter x:Key="DiagnosticStatusIconConverter" />
  </UserControl.Resources>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="2*" MinWidth="300" MaxWidth="440" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="5*" />
    </Grid.ColumnDefinitions>

    <!-- ===== Выбор компьютера ===== -->
    <DockPanel Grid.Column="0" Margin="16,16,8,16">
      <TextBlock DockPanel.Dock="Top" Text="Диагностика" Style="{StaticResource PageTitleStyle}" Margin="0,0,0,12" />
      <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
        <TextBox x:Name="FilterBox"
                 Padding="8,6"
                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                 PreviewKeyDown="OnFilterBoxKeyDown"
                 AutomationProperties.Name="Поиск компьютера"
                 AutomationProperties.AcceleratorKey="Ctrl+F" />
        <TextBlock Text="Имя, описание или ОС (Ctrl+F)"
                   Margin="11,0,8,0"
                   VerticalAlignment="Center"
                   IsHitTestVisible="False"
                   TextTrimming="CharacterEllipsis"
                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                   Visibility="{Binding SearchText, Converter={StaticResource EmptyToVisibilityConverter}}" />
      </Grid>
      <ListBox x:Name="ComputerList"
               ItemsSource="{Binding Computers}"
               SelectedItem="{Binding SelectedComputer, Mode=TwoWay}"
               PreviewKeyDown="OnComputerListKeyDown"
               MouseDoubleClick="OnComputerListDoubleClick"
               BorderThickness="0"
               Background="Transparent"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               VirtualizingStackPanel.IsVirtualizing="True"
               VirtualizingStackPanel.VirtualizationMode="Recycling"
               AutomationProperties.Name="Список компьютеров">
        <ListBox.ItemContainerStyle>
          <Style TargetType="ListBoxItem" BasedOn="{StaticResource ListItemStyle}">
            <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
          </Style>
        </ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate>
          <DataTemplate DataType="{x:Type models:ComputerInfo}">
            <StackPanel Orientation="Horizontal">
              <Ellipse Style="{StaticResource StatusDotStyle}" Margin="0,0,10,0"
                       Tag="{Binding AvailabilityStatus, Converter={StaticResource AvailabilityStatusConverter}}" />
              <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>

    <Border Grid.Column="1" Style="{StaticResource VerticalDividerStyle}" />

    <!-- ===== Отчёт ===== -->
    <Grid Grid.Column="2">
      <ScrollViewer Visibility="{Binding SelectedComputer, Converter={StaticResource NullToVisibilityConverter}}"
                    VerticalScrollBarVisibility="Auto">
        <Grid Margin="24">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MaxWidth="760" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="{Binding SelectedComputer.Name}" Style="{StaticResource PageTitleStyle}" TextTrimming="CharacterEllipsis"
                         ToolTip="{Binding SelectedComputer.Name}" />
              <TextBlock Text="Почему не работает shadow: политика, брандмауэр, служба, права"
                         Style="{StaticResource MutedTextStyle}" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,0,0,0">
              <Button Style="{StaticResource FlatActionButtonStyle}"
                      Margin="0,0,8,0"
                      Command="{Binding CopyReportCommand}"
                      ToolTip="Скопировать отчёт текстом (без паролей и секретов)"
                      AutomationProperties.Name="Скопировать отчёт">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Style="{StaticResource IconTextStyle}" FontSize="14" Margin="0,0,6,0"
                             Text="{Binding Source=copy, Converter={StaticResource IconGlyphConverter}}" />
                  <TextBlock Text="Скопировать отчёт" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button Content="Проверить"
                      Style="{StaticResource PrimaryButtonStyle}"
                      Command="{Binding RunCommand}"
                      ToolTip="Запустить проверку (F5, Enter или двойной щелчок по компьютеру)"
                      AutomationProperties.Name="Запустить диагностику" />
            </StackPanel>
          </Grid>

          <StackPanel Margin="0,16,0,0"
                      Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibilityConverter}}">
            <ProgressBar IsIndeterminate="True" Height="3" AutomationProperties.Name="Идёт проверка" />
            <TextBlock Text="Идёт проверка…" Style="{StaticResource MutedTextStyle}" Margin="0,6,0,0" />
          </StackPanel>

          <TextBlock Text="{Binding Error}"
                     Margin="0,16,0,0"
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                     Visibility="{Binding Error, Converter={StaticResource NullToVisibilityConverter}}" />

          <!-- Главный вывод -->
          <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0"
                  Visibility="{Binding VerdictText, Converter={StaticResource NullToVisibilityConverter}}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource IconTextStyle}" FontSize="28" Margin="0,0,14,0"
                         Text="{Binding VerdictStatus, Converter={StaticResource DiagnosticStatusIconConverter}}"
                         Foreground="{Binding VerdictStatus, Converter={StaticResource StatusToBrushConverter}}" />
              <TextBlock Text="{Binding VerdictText}"
                         FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="620"
                         VerticalAlignment="Center"
                         Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            </StackPanel>
          </Border>

          <ItemsControl ItemsSource="{Binding Items}" Margin="0,12,0,0" IsTabStop="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type pages:DiagnosticItemRow}">
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,8" Padding="14,12">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource IconTextStyle}" FontSize="20" Margin="0,1,12,0"
                               VerticalAlignment="Top"
                               Text="{Binding Item.Status, Converter={StaticResource DiagnosticStatusIconConverter}}"
                               Foreground="{Binding Item.Status, Converter={StaticResource StatusToBrushConverter}}"
                               ToolTip="{Binding Item.Status, Converter={StaticResource EnumTextConverter}}" />
                    <StackPanel Grid.Column="1">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Item.Title}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Border Style="{Binding Item.Status, Converter={StaticResource StatusToBadgeStyleConverter}}" Margin="8,0,0,0">
                          <TextBlock Text="{Binding Item.Status, Converter={StaticResource EnumTextConverter}}" />
                        </Border>
                      </StackPanel>
                      <TextBlock Text="{Binding Item.Detail}" Style="{StaticResource MutedTextStyle}" Margin="0,4,0,0"
                                 Visibility="{Binding Item.Detail, Converter={StaticResource NullToVisibilityConverter}}" />
                      <TextBlock Margin="0,6,0,0" TextWrapping="Wrap"
                                 Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                 Visibility="{Binding Item.Hint, Converter={StaticResource NullToVisibilityConverter}}">
                        <Run FontWeight="SemiBold" Text="Что исправить: " /><Run Text="{Binding Item.Hint, Mode=OneWay}" />
                      </TextBlock>
                    </StackPanel>
                    <ContentControl Grid.Column="2" Content="{Binding FixButton}" VerticalAlignment="Top"
                                    Visibility="{Binding FixButton, Converter={StaticResource NullToVisibilityConverter}}">
                      <ContentControl.ContentTemplate>
                        <DataTemplate>
                          <Button Style="{StaticResource FlatActionButtonStyle}"
                                  Margin="12,0,0,0"
                                  Command="{Binding Command}"
                                  IsEnabled="{Binding IsEnabled}"
                                  ToolTip="{Binding ToolTipText}"
                                  ToolTipService.ShowOnDisabled="True"
                                  AutomationProperties.Name="{Binding Title}">
                            <StackPanel Orientation="Horizontal">
                              <TextBlock Style="{StaticResource IconTextStyle}" FontSize="14" Margin="0,0,6,0"
                                         Text="{Binding Icon, Converter={StaticResource IconGlyphConverter}}" />
                              <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                            </StackPanel>
                          </Button>
                        </DataTemplate>
                      </ContentControl.ContentTemplate>
                    </ContentControl>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Text="Нажмите «Проверить» (F5), чтобы проверить компьютер."
                     Style="{StaticResource MutedTextStyle}"
                     Margin="0,16,0,0">
            <TextBlock.Visibility>
              <MultiBinding Converter="{StaticResource AnyTrueToVisibilityConverter}" ConverterParameter="invert">
                <Binding Path="IsRunning" />
                <Binding Path="Report" Converter="{StaticResource NotNullToBoolConverter}" />
                <Binding Path="Error" Converter="{StaticResource NotNullToBoolConverter}" />
              </MultiBinding>
            </TextBlock.Visibility>
          </TextBlock>
        </StackPanel>
        </Grid>
      </ScrollViewer>

      <StackPanel Style="{StaticResource EmptyStateStyle}"
                  Visibility="{Binding SelectedComputer, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=invert}">
        <TextBlock Text="{Binding Source=stethoscope, Converter={StaticResource IconGlyphConverter}}"
                   Style="{StaticResource IconTextStyle}" FontSize="40"
                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
        <TextBlock Text="Выберите компьютер" Style="{StaticResource EmptyStateTitleStyle}" />
        <TextBlock Text="Слева — все компьютеры домена. Выберите компьютер и нажмите «Проверить»."
                   Style="{StaticResource EmptyStateTextStyle}" />
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
