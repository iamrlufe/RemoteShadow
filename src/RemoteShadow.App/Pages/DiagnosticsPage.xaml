<UserControl x:Class="RemoteShadow.App.Pages.DiagnosticsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:RemoteShadow.Core.Models;assembly=RemoteShadow.Core"
             xmlns:pages="clr-namespace:RemoteShadow.App.Pages">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="320" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- ===== Выбор компьютера ===== -->
    <DockPanel Grid.Column="0" Margin="16,16,8,16">
      <TextBlock DockPanel.Dock="Top" Text="Диагностика" Style="{StaticResource PageTitleStyle}" Margin="0,0,0,12" />
      <TextBox DockPanel.Dock="Top"
               Margin="0,0,0,8"
               Padding="8,6"
               Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
               AutomationProperties.Name="Поиск компьютера" />
      <ListBox ItemsSource="{Binding Computers}"
               SelectedItem="{Binding SelectedComputer, Mode=TwoWay}"
               BorderThickness="0"
               Background="Transparent"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               ItemContainerStyle="{StaticResource ListItemStyle}"
               AutomationProperties.Name="Список компьютеров">
        <ListBox.ItemTemplate>
          <DataTemplate DataType="{x:Type models:ComputerInfo}">
            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>

    <Border Grid.Column="1" Style="{StaticResource VerticalDividerStyle}" />

    <!-- ===== Отчёт ===== -->
    <Grid Grid.Column="2">
      <ScrollViewer Visibility="{Binding SelectedComputer, Converter={StaticResource NullToVisibilityConverter}}"
                    VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" MaxWidth="760" HorizontalAlignment="Left">
          <Grid>
            <StackPanel>
              <TextBlock Text="{Binding SelectedComputer.Name}" Style="{StaticResource PageTitleStyle}" />
              <TextBlock Text="Почему не работает shadow: политика, брандмауэр, служба, права"
                         Style="{StaticResource MutedTextStyle}" Margin="0,4,0,0" />
            </StackPanel>
            <Button Content="Запустить диагностику"
                    Style="{StaticResource PrimaryButtonStyle}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Command="{Binding RunCommand}" />
          </Grid>

          <TextBlock Text="Идёт проверка…" Style="{StaticResource MutedTextStyle}" Margin="0,16,0,0"
                     Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibilityConverter}}" />
          <TextBlock Text="{Binding Error}"
                     Margin="0,16,0,0"
                     Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                     Visibility="{Binding Error, Converter={StaticResource NullToVisibilityConverter}}" />

          <TextBlock Text="{Binding Report.Verdict}"
                     Style="{StaticResource SectionTitleStyle}"
                     Margin="0,16,0,8"
                     Visibility="{Binding Report.Verdict, Converter={StaticResource NullToVisibilityConverter}}" />

          <ItemsControl ItemsSource="{Binding Items}" Margin="0,8,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type pages:DiagnosticItemRow}">
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,8">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <StackPanel Orientation="Horizontal">
                        <Border Style="{Binding Item.Status, Converter={StaticResource StatusToBadgeStyleConverter}}">
                          <TextBlock Text="{Binding Item.Status}" />
                        </Border>
                        <TextBlock Text="{Binding Item.Title}" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
                      </StackPanel>
                      <TextBlock Text="{Binding Item.Detail}" Style="{StaticResource MutedTextStyle}" Margin="0,6,0,0" />
                      <TextBlock Text="{Binding Item.Hint}"
                                 Style="{StaticResource CaptionMutedTextStyle}"
                                 Margin="0,4,0,0"
                                 Visibility="{Binding Item.Hint, Converter={StaticResource NullToVisibilityConverter}}" />
                    </StackPanel>
                    <ContentControl Grid.Column="1" Content="{Binding FixButton}" VerticalAlignment="Top"
                                    Visibility="{Binding FixButton, Converter={StaticResource NullToVisibilityConverter}}">
                      <ContentControl.ContentTemplate>
                        <DataTemplate>
                          <Button Style="{StaticResource FlatActionButtonStyle}"
                                  Margin="8,0,0,0"
                                  Command="{Binding Command}"
                                  IsEnabled="{Binding IsEnabled}"
                                  ToolTip="{Binding ToolTipText}"
                                  ToolTipService.ShowOnDisabled="True"
                                  Content="{Binding Title}" />
                        </DataTemplate>
                      </ContentControl.ContentTemplate>
                    </ContentControl>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Text="Нажмите «Запустить диагностику», чтобы проверить компьютер"
                     Style="{StaticResource MutedTextStyle}"
                     Margin="0,16,0,0"
                     Visibility="{Binding Report, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=invert}" />
        </StackPanel>
      </ScrollViewer>

      <StackPanel Style="{StaticResource EmptyStateStyle}"
                  Visibility="{Binding SelectedComputer, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=invert}">
        <TextBlock Text="&#xE9D9;" Style="{StaticResource IconTextStyle}" FontSize="40"
                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
        <TextBlock Text="Выберите компьютер" Style="{StaticResource EmptyStateTitleStyle}" />
        <TextBlock Text="Слева — все компьютеры домена. Выберите компьютер и запустите диагностику."
                   Style="{StaticResource EmptyStateTextStyle}" />
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
