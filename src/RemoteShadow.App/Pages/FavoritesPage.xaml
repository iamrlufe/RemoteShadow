<UserControl x:Class="RemoteShadow.App.Pages.FavoritesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pages="clr-namespace:RemoteShadow.App.Pages"
             xmlns:actions="clr-namespace:RemoteShadow.App.Shell.Actions">
  <UserControl.Resources>
    <!-- Строка компьютера: точка статуса, имя, «Открыть», быстрые действия, звезда. Один шаблон на оба списка. -->
    <DataTemplate x:Key="ComputerRowTemplate" DataType="{x:Type pages:FavoriteComputerItem}">
      <!-- Двойной щелчок по карточке — открыть компьютер, правая кнопка — меню действий. -->
      <Border Style="{StaticResource CardStyle}" Padding="12,10" Margin="0,0,0,8"
              ContextMenuOpening="OnRowContextMenuOpening">
        <Border.InputBindings>
          <MouseBinding Gesture="LeftDoubleClick"
                        Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}" />
        </Border.InputBindings>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <Ellipse Style="{StaticResource StatusDotStyle}"
                   Margin="2,0,12,0"
                   ToolTip="{Binding StatusText}"
                   Tag="{Binding IsOnline, Converter={StaticResource OnlineStatusConverter}}" />

          <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding StatusText}" Style="{StaticResource CaptionMutedTextStyle}"
                         Margin="10,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="{Binding Details}"
                       Style="{StaticResource CaptionMutedTextStyle}"
                       TextTrimming="CharacterEllipsis"
                       TextWrapping="NoWrap"
                       Visibility="{Binding Details, Converter={StaticResource NullToVisibilityConverter}}" />
          </StackPanel>

          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Style="{StaticResource AccentSubtleButtonStyle}"
                    Margin="0,0,8,0" MinWidth="92"
                    Content="Открыть"
                    Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding}"
                    ToolTip="Открыть компьютер в разделе «Компьютеры»"
                    AutomationProperties.Name="Открыть компьютер" />

            <ItemsControl ItemsSource="{Binding Buttons}" IsTabStop="False">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type actions:ActionButtonModel}">
                  <Button Style="{StaticResource FlatActionButtonStyle}"
                          Margin="0,0,8,0" MinWidth="84"
                          Command="{Binding Command}"
                          IsEnabled="{Binding IsEnabled}"
                          ToolTip="{Binding ToolTipText}"
                          ToolTipService.ShowOnDisabled="True"
                          AutomationProperties.Name="{Binding Title}">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Style="{StaticResource IconTextStyle}" FontSize="14" Margin="0,0,6,0"
                                 Text="{Binding Icon, Converter={StaticResource IconGlyphConverter}}" />
                      <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button Style="{StaticResource FlatActionButtonStyle}"
                    Margin="0" MinWidth="200"
                    Command="{Binding DataContext.RemoveFavoriteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding}"
                    Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVisibilityConverter}}"
                    AutomationProperties.Name="Убрать из избранного">
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource IconTextStyle}" FontSize="14" Margin="0,0,6,0" Text="&#xE735;"
                           Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                <TextBlock Text="Убрать из избранного" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Style="{StaticResource FlatActionButtonStyle}"
                    Margin="0" MinWidth="200"
                    Command="{Binding DataContext.AddFavoriteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding}"
                    Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=invert}"
                    AutomationProperties.Name="Добавить в избранное">
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource IconTextStyle}" FontSize="14" Margin="0,0,6,0"
                           Text="{Binding Source=star, Converter={StaticResource IconGlyphConverter}}" />
                <TextBlock Text="В избранное" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>
  </UserControl.Resources>

  <Grid>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <!-- Как на остальных страницах: содержимое прижато влево и не шире 980, а не плавает по центру широкого окна. -->
      <Grid Margin="16,16,24,24">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" MaxWidth="980" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
      <StackPanel>
        <Grid>
          <StackPanel>
            <TextBlock Text="Избранное" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="Двойной щелчок по компьютеру — открыть его, правая кнопка — все действия."
                       Style="{StaticResource CaptionMutedTextStyle}" Margin="0,4,0,0" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <ProgressBar IsIndeterminate="True" Width="60" Height="3" Margin="0,0,10,0"
                         Visibility="{Binding IsChecking, Converter={StaticResource BoolToVisibilityConverter}}"
                         AutomationProperties.Name="Проверка доступности" />
            <Button Style="{StaticResource FlatActionButtonStyle}" Margin="0"
                    Command="{Binding RefreshCommand}"
                    ToolTip="Обновить списки и проверить, какие компьютеры в сети (F5)"
                    AutomationProperties.Name="Обновить">
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource IconTextStyle}" FontSize="14" Margin="0,0,6,0"
                           Text="{Binding Source=refresh, Converter={StaticResource IconGlyphConverter}}" />
                <TextBlock Text="Обновить" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </StackPanel>
        </Grid>

        <Border Style="{StaticResource BadgeWarningStyle}" Margin="0,12,0,0" HorizontalAlignment="Stretch" Padding="10,6"
                Visibility="{Binding MissingText, Converter={StaticResource NullToVisibilityConverter}}">
          <TextBlock Text="{Binding MissingText}" TextWrapping="Wrap" />
        </Border>

        <!-- Пустое состояние -->
        <StackPanel Style="{StaticResource EmptyStateStyle}" Margin="0,48,0,0"
                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}">
          <TextBlock Text="{Binding Source=star, Converter={StaticResource IconGlyphConverter}}"
                     Style="{StaticResource IconTextStyle}" FontSize="40"
                     Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
          <TextBlock Text="Пока ничего нет" Style="{StaticResource EmptyStateTitleStyle}" />
          <TextBlock Style="{StaticResource EmptyStateTextStyle}"
                     Text="Добавьте компьютер в избранное в разделе «Компьютеры», чтобы подключаться к нему в один клик. Компьютеры, которые вы открывали недавно, появятся здесь сами." />
        </StackPanel>

        <!-- Избранные и недавние -->
        <StackPanel Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=invert}">
          <TextBlock Text="Избранные" Style="{StaticResource SectionTitleStyle}" Margin="0,20,0,10" />
          <TextBlock Style="{StaticResource MutedTextStyle}" Margin="0,0,0,8"
                     Text="Нет избранных компьютеров. Нажмите «В избранное» у компьютера из недавних или в разделе «Компьютеры»."
                     Visibility="{Binding HasFavorites, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=invert}" />
          <ItemsControl ItemsSource="{Binding Favorites}" ItemTemplate="{StaticResource ComputerRowTemplate}"
                        IsTabStop="False" AutomationProperties.Name="Избранные компьютеры" />

          <TextBlock Text="Недавние" Style="{StaticResource SectionTitleStyle}" Margin="0,20,0,10" />
          <TextBlock Style="{StaticResource MutedTextStyle}" Margin="0,0,0,8"
                     Text="Недавних компьютеров нет. Здесь появятся компьютеры, которые вы выбирали в разделе «Компьютеры»."
                     Visibility="{Binding HasRecent, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=invert}" />
          <ItemsControl ItemsSource="{Binding Recent}" ItemTemplate="{StaticResource ComputerRowTemplate}"
                        IsTabStop="False" AutomationProperties.Name="Недавние компьютеры" />
        </StackPanel>
      </StackPanel>
      </Grid>
    </ScrollViewer>
  </Grid>
</UserControl>
